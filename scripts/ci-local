#!/usr/bin/env bash
# Run everything .github/workflows/ci.yml runs, here, in one command.
#
#   ./scripts/ci-local          everything except the slow installer suite
#   ./scripts/ci-local --full   everything, including the installer matrix
#
# This exists because hosted CI is not always available, and "it passed on my
# machine" is only worth something if the machine ran the same gates. It is not
# a replacement: it cannot give you a clean Linux box or a second Python
# version, which is most of what hosted CI is for. Treat a green run here as
# necessary, not sufficient.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

pass=0; fail=0
run() {  # run <name> <command...>
  local name="$1"; shift
  local out
  if out=$("$@" 2>&1); then
    printf '  \033[32m✓\033[0m %-24s %s\n' "$name" "$(tail -1 <<<"$out")"
    pass=$((pass+1))
  else
    printf '  \033[31m✗\033[0m %-24s\n' "$name"
    sed 's/^/      /' <<<"$out" | tail -15
    fail=$((fail+1))
  fi
}

echo "guard"
run "rule suite"        python3 hooks/tests.py --no-perf
run "floor suite"       python3 hooks/floor.py
run "adapter suite"     python3 tests/adapters.py
run "Codex hook merge"  python3 tests/test_install_codex_hooks.py
run "Claude settings"   python3 tests/test_install_settings.py
run "release metadata"  python3 tests/test_release_metadata.py
run "npm CLI"           python3 tests/test_npx_cli.py
run "onboarding"        python3 tests/test_onboarding.py
run "install helpers"   python3 tests/test_install_helpers.py
run "project agent init" python3 tests/test_agent_init.py
run "wizard tests"      python3 operator-skills/wizard/tests/test_wizard.py
run "eval harness self" python3 evals/test_harness.py
run "skills evals"      python3 evals/run_evals.py
# 706 lines of tests that no gate ran. They cost 3 seconds and they cover the
# scoring the compliance harness publishes from, which is exactly the code
# whose last two results had to be withdrawn.
run "metrics tests"     python3 evals/compliance/test_metrics.py
run "session tests"     python3 evals/compliance/test_session.py
# The red-team corpus fails on an UNTRIAGED leak only. A candidate that is
# known and accepted carries a written reason and does not fail the build.
run "red team corpus"   python3 evals/redteam.py evals/redteam-candidates.txt

echo "performance"
run "DoS budgets"       python3 hooks/tests.py

echo "hygiene"
run "python syntax"     bash -c 'python3 -W error::SyntaxWarning -m compileall -q hooks/ evals/ operator-skills/ scripts/ tests/'
run "imports clean"     python3 -c "import sys; sys.path.insert(0,'hooks'); import guard_rules"
run "self-contained skills" bash -c 'test ! -e vendor && test -z "$(find skills -maxdepth 1 -mindepth 1 -type l)"'
run "no personal data"  python3 tests/audit.py
run "docs match code"   ./scripts/check-docs

if [[ "${1:-}" == "--full" ]]; then
  echo "installer"
  run "installer suite"  bash tests/install_test.sh
else
  echo "installer"
  printf '  \033[2m-\033[0m %-24s skipped, pass --full\n' "installer suite"
fi

echo
if (( fail )); then
  printf '\033[31mFAIL\033[0m  %d passed, %d failed\n' "$pass" "$fail"
  exit 1
fi
printf '\033[32mPASS\033[0m  %d gates, 0 failed\n' "$pass"
printf 'Not covered here: a clean Linux box, and Python 3.9. Hosted CI does those.\n'
printf 'Only covered here: macOS. Hosted CI does not run it, so this IS that gate.\n'
