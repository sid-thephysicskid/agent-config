#!/usr/bin/env bash
# Does the documentation still match the code?
#
# CI and contributors run this explicitly. Everything here must be a
# measurement rather than an opinion, or it becomes a noisy gate people ignore.
#
# Every check below compares a sentence in a doc against the thing it describes:
#   - run_evals.py holds check_context_budget_claim (the README's stated
#     token cost) and the guard_claims pins (each stated guard behaviour tied
#     to the exact sentence asserting it).
#   - selected public guardrail claims are executed against the live guard.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 0

fail=0

# Pinned doc claims. Error severity only: warnings are thresholds, not facts.
if ! out=$(python3 evals/run_evals.py --severity error 2>&1); then
  echo "$out" | grep -E "ERROR|doc-truth" || echo "$out" | tail -20
  fail=1
fi

# Every skill name the README lists must exist, and every skill must be listed.
# One direction only: every skill on disk must appear in the README. The
# reverse (every code-formatted word in the README must be a skill) would catch
# host commands and ordinary identifiers too. A check that cries wolf gets
# ignored.
missing=$(for root in skills operator-skills; do
  for d in "$root"/*/; do
    [ -f "$d/SKILL.md" ] || continue
    n=$(basename "$d")
    grep -q "\`$n\`" README.md || echo "  $root/$n exists but the README does not list it"
  done
done)
if [ -n "$missing" ]; then
  echo "README and packaged skills disagree:"
  echo "$missing"
  fail=1
fi

# The README's package counts are user-facing installation facts. Keep them
# derived from what will actually be packaged instead of letting a GitHub
# description or a remembered total drift.
workflow_count=$(find skills -mindepth 2 -maxdepth 2 -name SKILL.md | wc -l | tr -d ' ')
operator_count=$(find operator-skills -mindepth 2 -maxdepth 2 -name SKILL.md | wc -l | tr -d ' ')
if ! grep -q "ships $workflow_count workflow skills and $operator_count optional operator skills" README.md; then
  echo "README skill counts do not match the packaged directories: $workflow_count workflow, $operator_count operator"
  fail=1
fi

# The coverage list SECURITY.md defines a bypass against. Generated from the
# rule tables, so a rule added without regenerating fails here instead of
# leaving the security criterion pointing at prose that no longer exists.
if ! python3 scripts/guard-coverage --check; then
  fail=1
fi

# The global instructions the installer links are what an agent actually loads.
# They shipped carrying the skill routing and NONE of the safety rules, so every
# install produced hooks that block with no written policy behind them, and the
# rules that still apply when the hooks are absent were absent too. One source:
# the section in the template must be the section in AGENTS.md, verbatim.
if ! python3 -c 'import io,sys
b=io.open("AGENTS.md",encoding="utf-8").read()
t=io.open("templates/AGENTS.global.md",encoding="utf-8").read()
s=b[b.index("## Safety guardrails"):b.index("## Working method")].rstrip()
sys.exit(0 if s in t else 1)'; then
  echo "templates/AGENTS.global.md is missing AGENTS.md's safety section, or has a stale copy"
  fail=1
fi

# The README's case count is a user-facing claim about how well tested this is,
# so it is derived rather than remembered. Every other number in that paragraph
# is a link to a generated file.
if ! python3 -c 'import io,sys
sys.path.insert(0,"hooks")
import cases
n=len(cases.CMD_CASES)+len(cases.PATH_CASES)
r=io.open("README.md",encoding="utf-8").read()
sys.exit(0 if "{:,} test cases".format(n) in r else 1)'; then
  echo "README test-case count does not match hooks/cases.py"
  fail=1
fi

exit $fail
