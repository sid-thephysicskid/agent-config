#!/usr/bin/env python3
"""Generate docs/guard-coverage.md from the rules themselves.

SECURITY.md defines a reportable bypass as a command "the coverage list says is
blocked". That list did not exist: the prose describing it was removed from the
README, and nothing noticed, so the criterion for a security report pointed at
nothing and 22 accepted red-team leaks were triaged by citing it.

A hand-written list would rot the same way. This derives it from the rule
tables and the suite counts, and scripts/check-docs fails if the committed file
is not what regenerating produces.

    python3 scripts/guard-coverage           write docs/guard-coverage.md
    python3 scripts/guard-coverage --check    exit 1 if it is out of date
"""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "hooks"))
OUT = os.path.join(ROOT, "docs", "guard-coverage.md")

import floor  # noqa: E402
import guard_db  # noqa: E402
import guard_git  # noqa: E402
import guard_tools  # noqa: E402

PREAMBLE = """<!-- Generated by scripts/guard-coverage. Do not edit by hand. -->
# Guard coverage

## Who this is defending against

A careless agent, not an adversary. The guard reads one tool call at a time and
decides from the text of that call, immediately before it runs.

It is **not a security boundary**. It fails open on internal errors and on
analysis timeouts, a determined human or model can work around it, and it can
only see commands that arrive as tool calls. Deliberate obfuscation is out of
scope by design: encoding a command, hiding the verb in a variable, or handing
it to a remote host are all accepted gaps rather than defects. They are
enumerated with reasons in `evals/redteam-candidates.txt`.

What it is for is the mistake an agent makes while trying to help: committing to
a protected branch, force-pushing over someone's work, deleting the wrong tree,
reading a real credential, wiping a database it thought was local.

Keep branch protection, least-privilege credentials, database roles, backups,
CI, and human review. Those are the controls. This is a seatbelt.

## What is refused

Every entry below is generated from the rule that implements it. The lists are
the enumerable ones; the categories after them are matched by pattern rather
than by table, so they name the module that owns them instead.
"""

CATEGORIES = """
### Matched by pattern rather than by table

| Category | Owner |
|---|---|
| Commits and pushes on a protected branch, by any verb that writes history | `hooks/guard_git.py` |
| Force pushes, including the leading-plus refspec and an unpinned lease | `hooks/guard_git.py` |
| Discarding the working tree: reset, clean, checkout, restore, stash drop | `hooks/guard_git.py` |
| Reading, copying, printing or uploading a real credential or key | `hooks/guard_secrets.py` |
| Writing to a file that grants control: hooks, settings, git plumbing | `hooks/guard_paths.py` |
| Connecting to a host that looks like production | `hooks/guard_db.py` |
| Unqualified or tautological DELETE and UPDATE, DROP and TRUNCATE | `hooks/guard_db.py` |
| A program passed inline to an interpreter that deletes or reads secrets | `hooks/guard_rules.py` |
"""


def table(title, rows, note=""):
    out = ["\n### %s\n" % title]
    if note:
        out.append("%s\n" % note)
    for text in sorted(rows):
        out.append("- %s" % text.rstrip("."))
    return "\n".join(out) + "\n"


def main():
    parts = [PREAMBLE]
    parts.append(table(
        "Git", [r[1] for r in guard_git.DESTRUCTIVE_GIT]))
    parts.append(table(
        "Filesystem and tooling", [r[1] for r in guard_tools.DESTRUCTIVE_TOOLS]))
    parts.append(table(
        "Production deploys and publishes",
        [r[1] for r in guard_tools.PRODUCTION_DEPLOYS],
        "Refused so a release is a decision a human makes."))
    parts.append(table(
        "Database destruction", [r.reason for r in guard_db.DB_WIPE_RULES]))
    parts.append(CATEGORIES)
    parts.append("""
## How well it holds

Two suites, and the split is the point. `hooks/tests.py` grades the guard
against its own stated rules. `hooks/floor.py` grades it against the job, using
independent incident-shaped cases that were written without looking at the
implementation.

| Measure | Count |
|---|---|
| Liability shapes refused | %d |
| Ordinary commands allowed | %d |
| Decisions recorded with a reason | %d |
| Red-team candidates, accepted gaps with a written reason | %d |
| Red-team candidates leaking untriaged | 0, or CI fails |

An accepted gap is not a defect. It is a shape someone tried, decided was out
of scope, and wrote down, so the next person does not have to rediscover the
argument. Read them before reporting a bypass.
""" % (len(floor.LIABILITY), len(floor.ORDINARY), len(floor.DECIDED),
       sum(1 for line in open(os.path.join(ROOT, "evals",
                                           "redteam-candidates.txt"),
                              encoding="utf-8")
           if "\tOPEN:" in line)))
    rendered = "".join(parts)

    if "--check" in sys.argv:
        current = open(OUT, encoding="utf-8").read() if os.path.exists(OUT) else ""
        if current != rendered:
            print("docs/guard-coverage.md is out of date; "
                  "run python3 scripts/guard-coverage", file=sys.stderr)
            return 1
        return 0
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w", encoding="utf-8") as fh:
        fh.write(rendered)
    print("wrote docs/guard-coverage.md")
    return 0


if __name__ == "__main__":
    sys.exit(main())
