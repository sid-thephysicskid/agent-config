#!/usr/bin/env bash
# Build standalone plugin directories from the canonical monorepo sources.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORKFLOW_SKILLS=(navigate prototype bootstrap setup to-spec breakdown domain-modeling architect tdd diagnose review unstick ship)
OPERATOR_SKILLS=(research wizard handoff)
GUARD_FILES=(guard-bash.py guard-codex.py guard-files.py guard_adapter.py guard_db.py guard_git.py guard_parse.py guard_paths.py guard_repo.py guard_rules.py guard_secrets.py guard_tools.py)
OPERATOR_FILES=(output-styles/eli5.md output-styles/terse.md operator-profiles/codex/eli5.AGENTS.md operator-profiles/codex/terse.AGENTS.md)

if [[ $# -ne 1 ]]; then
  echo "Usage: ./scripts/build-plugins <new-output-directory>" >&2
  exit 1
fi

OUT="$1"
if [[ -e "$OUT" || -L "$OUT" ]]; then
  echo "Refusing to overwrite existing path: $OUT" >&2
  exit 1
fi

for name in "${WORKFLOW_SKILLS[@]}"; do
  [[ -f "$ROOT/skills/$name/SKILL.md" ]] || { echo "Missing workflow skill: $name" >&2; exit 1; }
done
for name in "${OPERATOR_SKILLS[@]}"; do
  [[ -f "$ROOT/operator-skills/$name/SKILL.md" ]] || { echo "Missing operator skill: $name" >&2; exit 1; }
done
for name in "${GUARD_FILES[@]}"; do
  [[ -f "$ROOT/hooks/$name" ]] || { echo "Missing guard runtime: $name" >&2; exit 1; }
done
for name in "${OPERATOR_FILES[@]}"; do
  [[ -f "$ROOT/$name" ]] || { echo "Missing operator asset: $name" >&2; exit 1; }
done
for name in LICENSE THIRD-PARTY-NOTICES.md; do
  [[ -f "$ROOT/$name" ]] || { echo "Missing legal file: $name" >&2; exit 1; }
done
for name in scripts/agent-init templates/AGENTS.project.md; do
  [[ -f "$ROOT/$name" ]] || { echo "Missing workflow asset: $name" >&2; exit 1; }
done

# Assemble beside the requested destination and publish with one rename. A
# failed copy or validation must not leave an output directory that blocks the
# next attempt.
OUT_PARENT="$(dirname "$OUT")"
mkdir -p "$OUT_PARENT"
OUT_PARENT="$(cd "$OUT_PARENT" && pwd)"
OUT="$OUT_PARENT/$(basename "$OUT")"
TMP="$(mktemp -d "$OUT_PARENT/.agent-config-build.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
BUILD="$TMP/payload"

GUARD="$BUILD/agent-guard"
WORKFLOW="$BUILD/agent-workflow"
OPERATOR="$BUILD/agent-operator"
mkdir -p "$GUARD/hooks" "$WORKFLOW/skills" "$WORKFLOW/scripts" \
         "$WORKFLOW/templates" \
         "$OPERATOR/skills" "$OPERATOR/output-styles" "$OPERATOR/operator-profiles"

cp -R "$ROOT/plugins/agent-guard/.codex-plugin" "$GUARD/.codex-plugin"
cp -R "$ROOT/plugins/agent-guard/.claude-plugin" "$GUARD/.claude-plugin"
cp "$ROOT/plugins/agent-guard/hooks/hooks.json" "$GUARD/hooks/hooks.json"
for name in "${GUARD_FILES[@]}"; do
  cp "$ROOT/hooks/$name" "$GUARD/hooks/$name"
done

cp -R "$ROOT/plugins/agent-workflow/.codex-plugin" "$WORKFLOW/.codex-plugin"
cp -R "$ROOT/plugins/agent-workflow/.claude-plugin" "$WORKFLOW/.claude-plugin"
for source in "$ROOT"/skills/*/; do
  [[ -f "$source/SKILL.md" ]] || continue
  cp -R "$source" "$WORKFLOW/skills/$(basename "$source")"
done
cp "$ROOT/scripts/agent-init" "$WORKFLOW/scripts/agent-init"
cp "$ROOT/templates/AGENTS.project.md" "$WORKFLOW/templates/AGENTS.project.md"

cp -R "$ROOT/plugins/agent-operator/.codex-plugin" "$OPERATOR/.codex-plugin"
cp -R "$ROOT/plugins/agent-operator/.claude-plugin" "$OPERATOR/.claude-plugin"
for source in "$ROOT"/operator-skills/*/; do
  [[ -f "$source/SKILL.md" ]] || continue
  cp -R "$source" "$OPERATOR/skills/$(basename "$source")"
done
cp "$ROOT/output-styles/eli5.md" "$OPERATOR/output-styles/eli5.md"
cp "$ROOT/output-styles/terse.md" "$OPERATOR/output-styles/terse.md"
mkdir -p "$OPERATOR/operator-profiles/codex"
cp "$ROOT/operator-profiles/codex/eli5.AGENTS.md" "$OPERATOR/operator-profiles/codex/eli5.AGENTS.md"
cp "$ROOT/operator-profiles/codex/terse.AGENTS.md" "$OPERATOR/operator-profiles/codex/terse.AGENTS.md"

# Running local Python tests may leave bytecode beside a bundled script. It is
# never part of a release and can encode machine-specific interpreter details.
find "$BUILD" -type f -name '*.pyc' -delete
find "$BUILD" -type d -name __pycache__ -empty -delete

for plugin in "$GUARD" "$WORKFLOW" "$OPERATOR"; do
  cp "$ROOT/LICENSE" "$plugin/LICENSE"
  cp "$ROOT/THIRD-PARTY-NOTICES.md" "$plugin/THIRD-PARTY-NOTICES.md"
done

if find "$BUILD" -type l -print -quit | grep -q .; then
  echo "Built artifacts unexpectedly contain a symlink." >&2
  exit 1
fi

if [[ -e "$OUT" || -L "$OUT" ]]; then
  echo "Destination appeared while building; refusing to overwrite it: $OUT" >&2
  exit 1
fi
mv "$BUILD" "$OUT"

echo "Built self-contained plugins in $OUT"
