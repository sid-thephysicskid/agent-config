#!/usr/bin/env bash
# The shellcheck CI runs, when it is installed locally.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
if ! command -v shellcheck >/dev/null 2>&1; then
  echo "shellcheck not installed, skipped (CI runs it)"
  exit 0
fi
shellcheck --severity=warning install.sh uninstall.sh scripts/migrate-legacy.sh tests/install_test.sh scripts/gates
