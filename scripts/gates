#!/usr/bin/env bash
# Every gate, run locally or in CI.
#   ./scripts/gates              fast gates
#   ./scripts/gates --full       plus the installer suite
#   ./scripts/gates --no-perf    skip wall-clock budgets (flaky on shared runners)
#   ./scripts/gates --hermetic   empty env and throwaway HOME; skips node gates
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

FULL=0; HERMETIC=0; PERF=1
for arg in "$@"; do
  case "$arg" in
    --full) FULL=1 ;;
    --hermetic) HERMETIC=1 ;;
    --no-perf) PERF=0 ;;
    *) printf 'usage: gates [--full] [--no-perf] [--hermetic]\n' >&2; exit 2 ;;
  esac
done

SANDBOX=""
if (( HERMETIC )); then
  SANDBOX="$(mktemp -d)"
  trap 'rm -rf "$SANDBOX"' EXIT
  mkdir -p "$SANDBOX/home" "$SANDBOX/tmp"
fi

# name | needs node | command
GATES=(
  "rule suite|no|python3 tests/rules.py --no-perf"
  "adapters|no|python3 tests/adapters.py"
  "red team|no|python3 tests/redteam.py tests/redteam-candidates.txt"
  "coverage doc|no|python3 scripts/guard-coverage --check"
  "settings merge|no|python3 tests/test_install_settings.py"
  "codex hooks|no|python3 tests/test_install_codex_hooks.py"
  "install helpers|no|python3 tests/test_install_helpers.py"
  "release metadata|no|python3 tests/test_release_metadata.py"
  "credential patterns|no|python3 tests/test_audit_patterns.py"
  "audit|no|python3 tests/audit.py"
  "python syntax|no|python3 -W error::SyntaxWarning -m compileall -q hooks/ scripts/ tests/"
  "shellcheck|no|bash scripts/shellcheck-if-present"
  "npm CLI|yes|python3 tests/test_npx_cli.py"
)
(( PERF )) && GATES+=("DoS budgets|no|python3 tests/rules.py")
(( FULL )) && GATES+=("installer suite|no|bash tests/install_test.sh")

pass=0; fail=0; skipped=0
run() {
  local name="$1"; shift
  local out rc=0
  if (( HERMETIC )); then
    out=$(env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME="$SANDBOX/home" \
              TMPDIR="$SANDBOX/tmp" PYTHONDONTWRITEBYTECODE=1 LC_ALL=C.UTF-8 \
              "$@" 2>&1) || rc=$?
  else
    out=$("$@" 2>&1) || rc=$?
  fi
  if (( rc == 0 )); then
    printf '  \033[32m✓\033[0m %-20s %s\n' "$name" "$(tail -1 <<<"$out")"
    pass=$((pass+1))
  else
    printf '  \033[31m✗\033[0m %-20s\n' "$name"
    sed 's/^/      /' <<<"$out" | tail -15
    fail=$((fail+1))
  fi
}

for entry in "${GATES[@]}"; do
  IFS='|' read -r name needs_node cmd <<<"$entry"
  if (( HERMETIC )) && [[ "$needs_node" == yes ]]; then
    printf '  \033[2m-\033[0m %-20s needs node, skipped\n' "$name"
    skipped=$((skipped+1))
    continue
  fi
  # shellcheck disable=SC2086
  run "$name" $cmd
done

echo
if (( fail )); then
  printf '\033[31mFAIL\033[0m  %d passed, %d failed, %d skipped\n' "$pass" "$fail" "$skipped"
  exit 1
fi
printf '\033[32mPASS\033[0m  %d gates, %d skipped\n' "$pass" "$skipped"
